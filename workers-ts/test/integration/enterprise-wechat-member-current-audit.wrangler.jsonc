{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cinashop-enterprise-wechat-member-current-audit",
  "main": "EnterpriseWechatMemberCurrentAuditWorker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 300000
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9748c294e21c49a99579c9cef70102e0"
    }
  ]

  // Before any temporary deployment, set all three hashes as secrets; never add
  // their values here:
  //   npx wrangler secret put AUDIT_READ_TOKEN_SHA256 --config <this-file>
  //   npx wrangler secret put AUDIT_MIGRATE_TOKEN_SHA256 --config <this-file>
  //   npx wrangler secret put AUDIT_ISOLATED_TOKEN_SHA256 --config <this-file>
}
