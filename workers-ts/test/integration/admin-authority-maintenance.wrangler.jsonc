{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cinashop-admin-authority-maintenance-template",
  "account_id": "7ea8e46d8210bad342fa7595f7935fea",
  "main": "AdminAuthorityMaintenanceWorker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  "workers_dev": true,
  "limits": { "cpu_ms": 10000 },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "AUDIT_TOKEN_SHA256": "",
    "AUDIT_EXPIRES_AT": "",
    "SOURCE_SHA": "",
    "EXPECTED_INSTALL_SQL_SHA256": "",
    "RUN_MARKER": "",
    "APPLY_ARMED": "false",
    "APPROVED_PREFLIGHT_SHA256": ""
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE_MAINTENANCE", "id": "9748c294e21c49a99579c9cef70102e0" },
    { "binding": "HYPERDRIVE", "id": "ba7faa6680cd48d4b3a1d36a7a5fc8f7" },
    { "binding": "HYPERDRIVE_ADMIN", "id": "446e94a4de0143f58c8e5178ec55db8b" }
  ]
}
