{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cinashop-test-image-maintenance",
  "main": "TestProductImageMaintenanceWorker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
