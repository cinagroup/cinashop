      "after_sha256": "a234d83d8eff6b64c5f1ed11c2dc0247ec86277b25d3ba8dca043b6090583893",
      "edits": [
        {
          "before_source": "",
          "after_source": "        <el-form-item label=\"社区组件\"><DiyCommunityEditor v-model=\"form.value\" :editor-key=\"`${editorIdentity}:${form.id}:${editorEpoch}`\" :page-id=\"form.id\" :page-published=\"persistedPublished\" :disabled=\"submitting || !formVisible || !sessionReady\" /></el-form-item>\n",
          "before_line": 105,
          "after_line": 105
        },
        {
          "before_source": "",
          "after_source": "import DiyCommunityEditor from '@/components/content/DiyCommunityEditor.vue';\nimport { canonicalCommunityValue } from '@/utils/diyCommunityEditor';\n",
          "before_line": 168,
          "after_line": 169
        },
        {
          "before_source": "    return canonicalCommerceValue(canonicalEditorialValue(canonicalStateValue(canonicalCarouselValue(canonicalNavigationValue(canonicalCustomerServiceValue(canonicalPresentationValue(canonicalFooterValue(value))))))));\n",
          "after_source": "    return canonicalCommunityValue(canonicalCommerceValue(canonicalEditorialValue(canonicalStateValue(canonicalCarouselValue(canonicalNavigationValue(canonicalCustomerServiceValue(canonicalPresentationValue(canonicalFooterValue(value)))))))));\n",
          "before_line": 302,
          "after_line": 305
        }
      ]
    },
    {
      "file": "workers-ts/src/services/content/DiyEditorialMediaPolicy.ts",
      "before_ref": "a7ad9f6cead6a0c1cbb2d09f740f6280c65b7d66",
      "before_sha256": "f798641f30679890efa049872fcf56b69c8eca9e658539c7908f6a1925ac28f2",
      "after_sha256": "a86968d78716dd83e9ed34c045d5b32da07ccc2ea6274a1b74f7c968a629dfd2",
      "edits": [
        {
          "before_source": "",
          "after_source": "export const DIY_COMMUNITY_MEDIA_SLOT_LIMIT = 20_000;\n",
          "before_line": 16,
          "after_line": 16
        },
        {
          "before_source": "  const counts = { ordinary: 0, navigation: 0, footer: 0, presentation: 0, customerService: 0, commerce: 0 };\n",
          "after_source": "  const counts = { ordinary: 0, navigation: 0, footer: 0, presentation: 0, customerService: 0, commerce: 0, community: 0 };\n",
          "before_line": 24,
          "after_line": 25
        },
        {
          "before_source": "",
          "after_source": "    else if (component.name === 'community') {\n      const owner = record(component.imgConfig);\n      if (owner && typeof owner.url === 'string') {\n        // Only the authored title image; public posts, avatars and snapshots\n        // never gain authority through the DIY schema or this separate budget.\n        slots.push({ value: owner.url, set: value => { owner.url = value; } });\n        counts.community++;\n      }\n    }\n",
          "before_line": 96,
          "after_line": 97
        },
        {
          "before_source": "  if (counts.ordinary > 2500 || counts.navigation > 20000 || counts.footer > DIY_FOOTER_MEDIA_SLOT_LIMIT || counts.presentation > DIY_PRESENTATION_MEDIA_SLOT_LIMIT || counts.customerService > DIY_CUSTOMER_SERVICE_MEDIA_SLOT_LIMIT || counts.commerce > DIY_COMMERCE_MEDIA_SLOT_LIMIT) {\n",
          "after_source": "  if (counts.ordinary > 2500 || counts.navigation > 20000 || counts.footer > DIY_FOOTER_MEDIA_SLOT_LIMIT || counts.presentation > DIY_PRESENTATION_MEDIA_SLOT_LIMIT || counts.customerService > DIY_CUSTOMER_SERVICE_MEDIA_SLOT_LIMIT || counts.commerce > DIY_COMMERCE_MEDIA_SLOT_LIMIT || counts.community > DIY_COMMUNITY_MEDIA_SLOT_LIMIT) {\n",
          "before_line": 151,
          "after_line": 161
        }
      ]
    },
    {
      "file": "view/uniapp-ts/src/utils/diyEditorialMediaLease.ts",
      "before_ref": "a7ad9f6cead6a0c1cbb2d09f740f6280c65b7d66",
      "before_sha256": "fdad2d028b67e5ea935177dd4fc63e9ac41a7574089187573c84df2280d3fa97",
      "after_sha256": "6d6dd351cd5c4648be897e8cdfc68c204e905b35d92655f1c461322e94bd7a52",
      "edits": [
        {
          "before_source": "    if (block.name === 'news') return [field('imgConfig')];\n",
          "after_source": "    if (block.name === 'news' || block.name === 'community') return [field('imgConfig')];\n",
          "before_line": 20,
          "after_line": 20
        }
      ]
    }
  ],
