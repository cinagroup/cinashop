{
  "name": "cinashop-workers",
  "version": "0.1.0",
  "private": true,
  "description": "CRMEB PRO → Cloudflare Workers 重构 (Hono + Hyperdrive + Upstash)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-drizzle-pg-order.cjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types worker-configuration.d.ts --env-interface WorkerBindings --include-runtime false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "audit:prod": "node scripts/run-production-dependency-audit.mjs",
    "audit:supplier-pages": "node scripts/audit-supplier-pages.mjs",
    "data:schema-audit": "tsx scripts/mysql-to-postgres.ts schema-audit",
    "audit:orm": "tsx scripts/orm-ddl-audit.ts",
    "audit:orm:not-valid": "tsx scripts/audit-pg-not-valid.ts",
    "audit:orm:sequences": "tsx scripts/audit-pg-sequence-state.ts",
    "audit:orm:foreign-key-indexes": "tsx scripts/foreign-key-index-audit.ts",
    "audit:work-fk:statistics-scale": "tsx scripts/audit-work-fk-statistics-scale.ts",
    "audit:paid-runtime-permissions": "tsx scripts/audit-paid-runtime-permissions.ts",
    "audit:work-parent-permissions": "tsx scripts/audit-work-parent-permissions.ts",
    "audit:shipping-lifecycle-baseline": "tsx scripts/audit-shipping-lifecycle-baseline.ts",
    "audit:shipping-lifecycle-capacity": "tsx scripts/audit-shipping-lifecycle-capacity.ts",
    "audit:routes": "tsx scripts/route-parity-audit.ts",
    "audit:admin-frontend": "tsx scripts/admin-frontend-parity-audit.ts",
    "audit:admin-api": "tsx scripts/admin-frontend-api-audit.ts",
    "audit:admin-setting": "tsx scripts/admin-setting-frontend-parity-audit.ts",
    "audit:admin-marketing": "tsx scripts/admin-marketing-frontend-parity-audit.ts",
    "audit:observability": "tsx scripts/observability-audit.ts",
    "audit:uniapp": "tsx scripts/uniapp-frontend-parity-audit.ts",
    "audit:diy-carousel-browser": "vitest run --config vitest.diy-carousel-browser.config.ts",
    "audit:diy-footer-browser": "vitest run --config vitest.diy-footer-browser.config.ts",
    "audit:diy-presentation-browser": "vitest run --config vitest.diy-presentation-browser.config.ts",
    "audit:diy-navigation-browser": "vitest run --config vitest.diy-navigation-browser.config.ts",
    "audit:legacy-schema:update": "tsx scripts/generate-legacy-schema-authority.ts",
    "data:plan": "tsx scripts/mysql-to-postgres.ts plan",
    "data:copy": "tsx scripts/mysql-to-postgres.ts copy",
    "data:verify": "tsx scripts/mysql-to-postgres.ts verify",
    "typecheck": "npm run typecheck:unit && npm run typecheck:runtime",
    "typecheck:unit": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "typecheck:runtime": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc -p tsconfig.runtime-test.json --noEmit",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:runtime": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:runtime:watch": "vitest --config vitest.worker.config.ts",
    "audit:diy-customer-service-browser": "vitest run --config vitest.diy-customer-service-browser.config.ts",
    "audit:diy-page-settings-browser": "vitest run --config vitest.diy-page-settings-browser.config.ts",
    "audit:diy-media-reference-browser": "vitest run --config vitest.diy-media-reference-browser.config.ts",
    "audit:diy-navigation-author-browser": "vitest run --config vitest.diy-navigation-author-browser.config.ts",
    "test:diy-author-options": "vitest run --config vitest.config.ts --maxWorkers=1 test/admin-diy-author-options.test.ts test/admin-diy-author-options-postgres.test.ts test/admin-diy-author-options-http.test.ts",
    "test:diy-navigation-author": "vitest run --config vitest.config.ts --maxWorkers=1 test/diy-navigation-author-postgres.test.ts test/diy-navigation-author-runner.test.ts",
    "audit:diy-carousel-author-browser": "vitest run --config vitest.diy-carousel-author-browser.config.ts",
    "test:diy-carousel-author": "vitest run --config vitest.config.ts --maxWorkers=1 test/diy-carousel-author-postgres.test.ts test/diy-carousel-author-runner.test.ts",
    "audit:diy-list-author-browser": "vitest run --config vitest.diy-list-author-browser.config.ts",
    "test:diy-list-author": "vitest run --config vitest.config.ts --maxWorkers=1 test/diy-list-author-postgres.test.ts test/diy-list-author-runner.test.ts",
    "test:diy-list-author-options": "vitest run --config vitest.config.ts --maxWorkers=1 test/admin-diy-list-author-options.test.ts test/admin-diy-list-author-options-postgres.test.ts test/admin-diy-list-author-options-http.test.ts",
    "test:diy-state-author": "vitest run --config vitest.config.ts --maxWorkers=1 test/diy-state-author-media.test.ts test/diy-state-author-postgres.test.ts test/diy-state-author-runner.test.ts",
    "audit:diy-state-author-browser": "vitest run --config vitest.diy-state-author-browser.config.ts",
    "audit:diy-commerce-author-browser": "vitest run --config vitest.diy-commerce-author-browser.config.ts",
    "test:diy-commerce-author": "vitest run --config vitest.config.ts --maxWorkers=1 test/diy-commerce-author-media.test.ts test/diy-commerce-author-postgres.test.ts",
    "audit:diy-community-author-browser": "vitest run --config vitest.diy-community-author-browser.config.ts",
    "test:diy-community-author": "vitest run --config vitest.config.ts --maxWorkers=1 test/diy-community-author-media.test.ts test/diy-community-author-postgres.test.ts",
    "test:cart-management:browser": "vitest run --config vitest.cart-management-browser.config.ts --maxWorkers=1",
    "test:admin-user-filters:browser": "vitest run --config vitest.admin-user-filters-browser.config.ts --maxWorkers=1",
    "test:admin-level-definitions:browser": "vitest run --config vitest.admin-level-definitions-browser.config.ts --maxWorkers=1",
    "test:admin-member-packages:browser": "vitest run --config vitest.admin-member-packages-browser.config.ts --maxWorkers=1",
    "test:customer-sign-centre:browser": "vitest run --config vitest.customer-sign-centre-browser.config.ts --maxWorkers=1",
    "test:customer-points-centre:browser": "vitest run --config vitest.customer-points-centre-browser.config.ts --maxWorkers=1",
    "test:customer-growth-records:browser": "vitest run --config vitest.customer-growth-records-browser.config.ts --maxWorkers=1",
    "test:customer-level-overview:browser": "vitest run --config vitest.customer-level-overview-browser.config.ts --maxWorkers=1",
    "test:member-level-recommendations:browser": "vitest run --config vitest.member-level-recommendations-browser.config.ts --maxWorkers=1",
    "test:customer-profile:browser": "vitest run --config vitest.customer-profile-browser.config.ts --maxWorkers=1",
    "test:membership-rights:browser": "vitest run --config vitest.membership-rights-browser.config.ts --maxWorkers=1",
    "test:membership-card-activation:browser": "vitest run --config vitest.membership-card-activation-browser.config.ts --maxWorkers=1",
    "test:membership-home:browser": "vitest run --config vitest.membership-home-browser.config.ts --maxWorkers=1",
    "test:membership-coupons:browser": "vitest run --config vitest.membership-coupons-browser.config.ts --maxWorkers=1",
    "test:member-level-activation:browser": "vitest run --config vitest.member-level-activation-browser.config.ts --maxWorkers=1",
    "test:membership-clause:browser": "vitest run --config vitest.membership-clause-browser.config.ts --maxWorkers=1"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.13",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@electric-sql/pglite": "0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "drizzle-kit": "file:vendor/drizzle-kit-0.31.10-no-esm-loader.tgz",
    "esbuild": "0.28.2",
    "miniflare": "5.20260910.0-alpha",
    "mysql2": "3.23.2",
    "tsx": "4.23.11",
    "typescript": "^5.7.2",
    "vitest": "4.1.12",
    "wrangler": "4.131.0"
  }
}
