{
  "name": "cinashop-workers",
  "version": "0.1.0",
  "private": true,
  "description": "CRMEB PRO → Cloudflare Workers 重构 (Hono + Hyperdrive + Upstash)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types worker-configuration.d.ts --env-interface WorkerBindings --include-runtime false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "audit:prod": "npm audit --omit=dev --audit-level=low --registry=https://registry.npmjs.org",
    "data:schema-audit": "tsx scripts/mysql-to-postgres.ts schema-audit",
    "audit:routes": "tsx scripts/route-parity-audit.ts",
    "audit:observability": "tsx scripts/observability-audit.ts",
    "audit:legacy-schema:update": "tsx scripts/generate-legacy-schema-authority.ts",
    "data:plan": "tsx scripts/mysql-to-postgres.ts plan",
    "data:copy": "tsx scripts/mysql-to-postgres.ts copy",
    "data:verify": "tsx scripts/mysql-to-postgres.ts verify",
    "typecheck": "npm run typecheck:unit && npm run typecheck:runtime",
    "typecheck:unit": "tsc --noEmit",
    "typecheck:runtime": "tsc -p tsconfig.runtime-test.json --noEmit",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:runtime": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:runtime:watch": "vitest --config vitest.worker.config.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "mysql2": "3.23.2",
    "tsx": "4.23.11",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "4.122.0"
  }
}
