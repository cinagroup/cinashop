# Copy this file to .dev.vars for local development. Never commit real values.
APP_KEY=replace-with-a-long-random-value
UPSTASH_REDIS_URL=https://replace-me.upstash.io
UPSTASH_REDIS_TOKEN=replace-me
DEBUG=1
NODE_ENV=development
OPERATIONS_TOKEN=replace-with-a-separate-long-random-value

# Exact browser origins. Keep each login audience narrower than the general CORS list.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5178
PC_AUTH_ALLOWED_ORIGINS=http://localhost:5173
KEFU_AUTH_ALLOWED_ORIGINS=http://localhost:5178

# WeChat Open Platform website-login AppSecret. Configure with `wrangler secret put`.
# The public AppID remains in system_config as `wechat_open_app_id`.
WECHAT_OPEN_APP_SECRET=

# Optional secure first-admin bootstrap. The password must be at least 12 characters.
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# ChatRoomDO -> Worker persistence channel.
INTERNAL_API_URL=http://localhost:8787

# WeChat Pay API v3 (PEM values can be quoted multiline values in .dev.vars).
WECHAT_MCH_PRIVATE_KEY=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_PUBLIC_KEY_ID=
WECHAT_REFUND_NOTIFY_URL=http://localhost:8787/api/pay/notify/wechat/refund

# Alipay H5 (required together; PEM values may be quoted multiline values in .dev.vars).
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=http://localhost:8787/api/pay/notify/alipay
ALIPAY_RETURN_URL=http://localhost:5173/order/pay-result

# Optional real carrier tracking. Also set system_config logistics_type=2.
ALIYUN_EXPRESS_APP_CODE=

# CRMEB 一号通 electronic waybill allocation. Both values are secrets; never
# store them in system_config/store_config or commit real values here.
CRMEB_ONEPASS_ACCESS_KEY=
CRMEB_ONEPASS_SECRET_KEY=

# Supplier onboarding SMS verification. Access keys must be Worker secrets.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_VERIFICATION_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou

# Cloudflare Turnstile. Keep the secret in `.dev.vars` locally and use
# `wrangler secret put TURNSTILE_SECRET_KEY` in deployed environments.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost

# Sign in with Apple audiences (bundle ID and/or Services ID). This is not a secret.
# Native clients must request /api/apple_login/challenge and place nonceSha256 in
# the Apple authorization request before sending identityToken + nonce_key.
APPLE_SIGN_IN_CLIENT_IDS=
