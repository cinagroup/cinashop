  "legacy_http": {
    "seed": "GET /supplierapi/order/refund/:id",
    "write": "PUT /supplierapi/order/refund/:id",
    "id": "store_order integer primary key",
    "fields": [
      "refund_price",
      "type(default1)"
    ],
    "selection": "Whole order total_num and all purchase carts; no item selection input."
  },
  "behavior": {
    "type1": "Create and execute whole-goods refund; requested cash may be below the whole payment remaining. Legacy success deletes refund rows and updates cumulative order.refund_price, allowing later payment remainder topups.",
    "type2": "After common amount/open-refund checks only set order refund_status0/refund_type3; no refund entity or financial effects.",
    "channels": [
      "offline/cash manual return",
      "yue balance credit",
      "weixin original provider",
      "alipay original provider"
    ],
    "source_mismatches": "Legacy GET and PUT have different active-refund sets and PUT omits several live checks. TS must preserve real actor/tenant/paid/root invariants, not port these authorization omissions.",
    "history": "Do not delete protected refund/payment/materialization/invoice history to imitate old temporary-row deletion.",
    "nonmonetary": "Legacy inventory has a refund_price-audit guard; other old side effects do not uniformly have once-only proof. New monetary continuation must not repeat inventory/points/coupons/commission/Supplier goods settlement."
  },
  "current_gap": {
    "public_order_id_route": false,
    "existing_refund_id_manual_review_is_not_substitute": true,
    "general_application_authority": "Current Supplier application capability intentionally onlycash/offline; full migration also needs real Supplier authority for yue/weixin/alipay.",
    "cash_remainder": "Existing materialized quantity protocol consumes all selected goods on the first discounted whole-goods refund; leftover paid money cannot be represented as another goods quote. A protected money-only continuation is required.",
    "invoice_execution": "Existing invoice preparation rejects goods/payment concessions; the pure full-ticket plan has no SQL cancellation/red-note integration yet.",
    "capital_flow": "The existing generic refund core has no capital_flow writer. A once-only actual monetary event writer remains required; Supplier settlement is not its substitute.",
    "quantity_baseline_projection": "Existing deep quantity proofs require the first goods refund amount. A separately verified monetary baseline view must preserve those proofs while the real order reflects cumulative money.",
    "authority": "The legacy order-ID action needs genuine supplier.order.manage authority across all channels. The existing cash-only refund.manage capability is not a substitute."
  },
  "required_proofs": [
    "Actual JWT, live tenant/role/menu/DBclock and independent restricted LOGIN.",
    "Whole quantity first refund, explicit actual positive cash confirmation, zero cash omission, exact minor-unit sums.",
    "Cash-only continuation binds its first genuine all-goods completion, immutable purchase/payment root and original effect receipts; no repeated nonmonetary effects.",
    "Preserve Supplier goods settlement reversal; continuation proves zero further settlement deduction and records only actual money delta.",
    "Persist provider admission before I/O; callback/reconciliation dispatch by protected durable continuation identity, never an in-memory JSON bypass.",
    "Original UUID ownership receipts, read-only unknown GET and explicit not_applied fence; lost creation/local COMMIT/provider responses never auto-replay a different operation.",
    "Balance and both providers, cancellation/deletion/foreign tenant/source mutations/concurrent writers, retained evidence, points/coupon/commission/invoice and virtual-secret invariants.",
    "Real Supplier frontend entry and desktop/mobile Browser validation."
  ],
