          "before_source": "<script setup lang=\"ts\">\nimport { useThemeStore } from \"@/stores/theme\";\nimport { useShareReferral } from '@/composables/useShareReferral';\nimport { onLaunch, onShow, onHide } from \"@dcloudio/uni-app\";\n// #ifdef H5\nimport { loadStatisticsScript } from '../../common/statisticsScript';\nimport { API_BASE } from '@/utils/request';\n// #endif\n\nconst theme = useThemeStore();\nconst referrals = useShareReferral();\nonLaunch((options) => {\n  referrals.captureInbound(options);\n  theme.syncPlatform();\n  void theme.refresh();\n  // #ifdef H5\n  loadStatisticsScript(API_BASE);\n  // #endif\n  console.log(\"CinaShop App Launch\");\n});\n\nonShow((options) => {\n  referrals.captureInbound(options);\n  theme.syncPlatform();\n  void theme.refresh();\n  console.log(\"App Show\");\n});\n\nonHide(() => {\n  theme.pause();\n  console.log(\"App Hide\");\n});\n</script>",
          "after_source": "<script setup lang=\"ts\">\nimport { useThemeStore } from \"@/stores/theme\";\nimport { useShareReferral } from '@/composables/useShareReferral';\nimport { onLaunch, onShow, onHide } from \"@dcloudio/uni-app\";\n// #ifdef H5\nimport { loadStatisticsScript } from '../../common/statisticsScript';\nimport { API_BASE } from '@/utils/request';\n// #endif\n\nimport { useDiyFooterStore } from '@/stores/diyFooter';\nconst footer = useDiyFooterStore();\nconst theme = useThemeStore();\nconst referrals = useShareReferral();\nonLaunch((options) => {\n  footer.resume();\n  referrals.captureInbound(options);\n  theme.syncPlatform();\n  void theme.refresh();\n  // #ifdef H5\n  loadStatisticsScript(API_BASE);\n  // #endif\n  console.log(\"CinaShop App Launch\");\n});\n\nonShow((options) => {\n  footer.resume();\n  referrals.captureInbound(options);\n  theme.syncPlatform();\n  void theme.refresh();\n  console.log(\"App Show\");\n});\n\nonHide(() => {\n  footer.pause();\n  theme.pause();\n  console.log(\"App Hide\");\n});\n</script>",
