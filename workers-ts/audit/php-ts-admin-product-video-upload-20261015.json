  "legacy_contract": {
    "upload_route": "POST /adminapi/file/video_upload",
    "multipart_fields_exactly": [
      "chunkNumber",
      "currentChunkSize",
      "chunkSize",
      "totalChunks",
      "file",
      "md5",
      "filename",
      "pid"
    ],
    "field_count": 8,
    "piece_index": "1-based; actual clients send decimal string fields and a Blob/File chunk; blob MIME may be empty or application/octet-stream",
    "actual_client_chunk_bytes": 3145728,
    "md5_semantics": "旧 upload.js 先 readAsBinaryString(file)，再 js-md5(binaryString)。服务将该 md5 仅作为 opaque client identity，不声称是原始全文件字节摘要；服务仍为每个实际分片计算 SHA256 并固定首次内容。",
    "stable_identity": "由 APP_KEY HMAC、actor_id、filename、归一化 client_md5 确定 UUIDv4 形状的旧会话标识；同请求重传返回同素材，不以可变时间窗口重新分配身份。",
    "pid_undefined_compatibility": {
      "actual_trigger": "productAdd.videoSaveToUrl 调 uploadByPieces 时不传 pid；FormData.append(pid, undefined) 实际发送字符串 undefined。",
      "php_behavior": "PHP 将 pid 强转 int，undefined 归根分类0。",
      "ts_behavior": "只对旧适配器精确兼容 null 或字符串 undefined 为0；现代 manifest pid 仍要求严格有界整数。"
    },
    "responses": {
      "nonfinal": {
        "code": 1,
        "msg": "waiting",
        "file_path": ""
      },
      "final": {
        "code": 2,
        "msg": "success",
        "canonical_url": "/api/assets/<actual_attachment_id>",
        "name": "stable canonical reference",
        "dir": "stable canonical reference",
        "file_path": "separate temporary signed playback URL"
      },
      "replay_rule": "即使会话已经提交，重传非末片仍返回 code1；末片重传返回 code2 和同一素材 ID。旧 upload.js 只有 code1 分支 resolve，提前 code2 会使其序列停住。"
    },
    "legacy_external_registration": {
      "route": "POST /adminapi/file/video_attachment",
      "input_keys": [
        "path",
        "cover_image",
        "pid",
        "upload_type"
      ],
      "response": true,
      "limits": "HTTPS MP4/受控图片封面URL，规范化后各<=200字符；name以稳定摘要生成且<=100字符；不执行远端下载或自动封面获取。"
    }
  },
