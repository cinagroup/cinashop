  "contract": {
    "source": "PHP view/admin/src/pages/marketing/storeBargain/create.vue uses one selected source SKU; StoreBargainServices::saveData derives main inventory/prices from attrs[0].",
    "creation": "Requires sku.baseUnique; allocates globally collision-checked independent type=2 identity, selected dimensions and attr result in the same transaction.",
    "editing": "Preserves existing identity and sales, forbids changing source product or SKU combination, does not shrink existing multi-SKU rows. Original SKU id/unique/stock/quota required; explicit main inventory edits retain the existing main-pair comparison. Price-only saves preserve differing SKU inventory.",
    "locking": "After activity NO KEY UPDATE and source product SHARE, global identity pg_try_advisory_xact_lock and secondary SKU NOWAIT reject contention rather than wait across incompatible existing lock orders. This is a bounded local solution, not a universal lock-order claim.",
    "read": "Authenticated GET in adminapi and v1 admin route groups; repeatable-read read-only transaction, max 500 per option/current list, private no-store and narrow projection excluding diskInfo.",
    "release": "New creation request requires sku. Coordinate Worker/Admin rollout; old clients without sku cannot create. Existing metadata-only saves remain supported."
  },
